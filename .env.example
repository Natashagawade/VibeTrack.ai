# ============================================================
# VibeTrack AI — environment variables
# Copy this file to .env.local and fill in the keys you have.
# Every AI/media module gracefully degrades (or clearly says
# "needs this key") when a value is missing — nothing crashes
# on startup without keys.
# ============================================================

# --- AI providers ---
# Powers Text/CSV/Documents/URL analysis upgrade to AI-grade
# scoring, Whisper transcription, and GPT-4o-mini vision.
OPENAI_API_KEY=

# Optional alternate/additional provider — not yet wired to a
# route, present for when you add Gemini-backed endpoints.
GEMINI_API_KEY=

# Optional — for swapping in open-source models via HF Inference API.
HUGGINGFACE_API_KEY=

# --- Media storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Database (Prisma + Postgres, e.g. Neon) ---
DATABASE_URL=

# --- Redis (job queues, distributed rate limiting/cache) ---
REDIS_URL=

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (verification, password reset, alerts) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Media AI (alternates/extras) ---
WHISPER_API_KEY=
OCR_API_KEY=

# --- Social & news listening ---
NEWS_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# --- Misc ---
SERPAPI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
